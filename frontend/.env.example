# FastAPI backend origin (paths already include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase Auth (Project Settings → API Keys). Public values: never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local development only, used when the two Supabase values above are empty:
# backend dev user sent as X-Dev-User-Id (requires ENVIRONMENT=development on the backend).
NEXT_PUBLIC_DEV_USER_ID=
