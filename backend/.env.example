ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bryt:bryt@localhost:5432/bryt
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Supabase Auth (JWKS verification). Leave empty in local dev and use the X-Dev-User-Id header.
SUPABASE_URL=
# Only for legacy projects still signing tokens with HS256
SUPABASE_JWT_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Run the post-activity agent pipeline automatically after each new activity
AGENTS_ENABLED=true
# Weekly plan refinement (Sunday 20:00 athlete-local); checked every SCHEDULER_INTERVAL_S
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_S=1800
# Intervals.icu poll for new runs (personal API keys get no webhooks)
INTERVALS_POLL_ENABLED=true
INTERVALS_POLL_INTERVAL_S=900

INTERVALS_BASE_URL=https://intervals.icu/api/v1
# Only needed with a registered Intervals.icu app (webhooks are tied to OAuth apps)
INTERVALS_WEBHOOK_SECRET=
INTERVALS_SYNC_DEFAULT_DAYS=14

STORAGE_DIR=storage
MAX_FIT_UPLOAD_MB=25
CORS_ORIGINS=["http://localhost:3000"]
